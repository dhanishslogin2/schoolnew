RewriteEngine On

# ------------------------------------------------------------------
# Static files: serve directly — never route through CodeIgniter.
# This is critical: without these two conditions, Apache rewrites
# CSS/JS/image requests to index.php which returns HTML, not the file.
# ------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through CodeIgniter's front controller
RewriteRule ^(.*)$ index.php/$1 [L]

# ------------------------------------------------------------------
# Environment-specific BASE_URL
# ------------------------------------------------------------------
# On the DEV SERVER (dev.login2.in): inject BASE_URL so config.php
# uses it instead of auto-detecting the internal IP from HTTP_HOST.
# On localhost: this SetEnvIf does NOT match → auto-detection runs
# normally → base_url() resolves to http://localhost/schoolnew/.
# ------------------------------------------------------------------
SetEnvIf Host "dev\.login2\.in" BASE_URL=http://dev.login2.in/schoolnew/
